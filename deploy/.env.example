# deploy/.env 로 복사해서 채운다. deploy/.env는 git에 올리지 않는다.

# 서비스 도메인 (DNS A 레코드를 이 서버 IP로 맞춘 뒤 띄운다). 시험할 때는 localhost
DOMAIN=kh.example.com

# DB 비밀번호 — 길고 무작위로
POSTGRES_PASSWORD=

# 로그인 (GOOGLE_CLIENT_ID를 비우면 로그인 없이 동작한다 — 공개 서버에서는 반드시 채운다)
# Google Cloud Console의 OAuth 클라이언트에 https://<DOMAIN> 을 승인된 JavaScript 원본으로 추가해야 한다
GOOGLE_CLIENT_ID=
SESSION_SECRET=
ADMIN_EMAILS=

# 임베딩 모델 (바꾸면 차원도 맞춘다. 가벼운 구성: intfloat/multilingual-e5-small / 384)
EMBED_MODEL=nlpai-lab/KURE-v1
EMBED_DIM=1024
